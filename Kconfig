DT_COMPAT_CODEKEEB_BATTERY_NRF_VDDH_CURVE := codekeeb,battery-nrf-vddh-curve

config CODEKEEB_BATTERY_NRF_VDDH_CURVE
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_CODEKEEB_BATTERY_NRF_VDDH_CURVE))
    select ADC
    select ZMK_BATTERY
    depends on SENSOR
    help
      Driver de bateria por VDDH del nRF52 con curva de descarga LiPo
      realista en lugar de la aproximacion lineal de ZMK.

# --- RGB FX (efectos de animacion, codigo vendorizado de zmk-rgb-fx, MIT) ---

config ZMK_RGB_FX
    bool "RGB animation effects"
    depends on LED_STRIP
    help
      Sistema de animaciones RGB (ripple, sparkle, gradient, solid)
      que sustituye al underglow estandar de ZMK.

config ZMK_RGB_FX_FPS
    int "RGB effect FPS"
    range 1 60
    default 30
    depends on ZMK_RGB_FX

config ZMK_RGB_FX_PIXEL_DISTANCE
    bool "Pixel distance lookup table"
    default y
    depends on ZMK_RGB_FX
    help
      Tabla de distancias entre pixeles usada por el efecto ripple.

# --- Encoder rotation bindings editable en runtime via ZMK Studio ---
#
# CENTRAL-ONLY, deliberately: ZMK itself never runs sensor-rotate
# behavior logic on a split peripheral (app/CMakeLists.txt guards
# behavior_sensor_rotate_common.c and behavior_queue.c behind
# `if ((NOT CONFIG_ZMK_SPLIT) OR CONFIG_ZMK_SPLIT_ROLE_CENTRAL)`) -- a
# peripheral's own encoder reports raw rotation, which ZMK's split link
# forwards to the central, and the central is what always decides what
# to do with it, for BOTH encoders. Confirmed by a real CI failure this
# behavior tried to compile into sofle_right (peripheral) at first:
# "undefined reference to zmk_behavior_queue_add" (that symbol doesn't
# even exist in a peripheral build). Its own .c file is guarded the same
# way ZMK's is, so this Kconfig option simply never applies there.
#
# Only ever enabled on the half with ZMK_STUDIO (this repo's sofle_left),
# since that's the only place it's useful.

# --- Macros editables en runtime (&dmac) ---
#
# ZMK's own macros are compile-time devicetree nodes, so Studio can never
# author one. This is a bank of slots whose contents live in flash and can
# be rewritten live from the keymap editor.

DT_COMPAT_ZMK_DYNAMIC_MACRO := zmk,behavior-dynamic-macro

config ZMK_BEHAVIOR_DYNAMIC_MACRO
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_DYNAMIC_MACRO))
    select SETTINGS
    # CENTRAL-ONLY: replaying a macro emits HID, which only the central can
    # do. Same guard as &mwheel and the dynamic sensor-rotate behavior.
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Runtime-editable macro slots (&dmac). Each slot stores a sequence of
      key taps, Unicode codepoints and waits, persisted in flash.

config ZMK_DYNAMIC_MACRO_SLOTS
    int "Number of runtime-editable macro slots"
    default 12
    range 1 32
    depends on ZMK_BEHAVIOR_DYNAMIC_MACRO
    help
      Each slot costs about 100 bytes of RAM plus a settings record, so
      keep this close to what you actually use.

# --- Rueda de raton discreta (&mwheel) ---
#
# One wheel tick per press, unlike ZMK's stock &msc which needs to be held
# across several work-loop cycles and therefore cannot be driven from an
# encoder at all. See src/behaviors/behavior_mouse_wheel.c.

DT_COMPAT_ZMK_MOUSE_WHEEL := zmk,behavior-mouse-wheel

config ZMK_BEHAVIOR_MOUSE_WHEEL
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_MOUSE_WHEEL))
    depends on ZMK_POINTING
    # CENTRAL-ONLY: zmk_hid_mouse_scroll_set()/zmk_endpoints_send_mouse_report()
    # only exist in a central build -- the peripheral has no HID stack of its
    # own, it just forwards key events over the split link. The behavior has
    # BEHAVIOR_LOCALITY_CENTRAL anyway, so the central is the only place it
    # ever runs. (Confirmed by a real CI link failure building it into
    # sofle_right: "undefined reference to zmk_hid_mouse_scroll_set".)
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Discrete mouse wheel behavior (&mwheel): sends exactly one HID wheel
      event per invocation, so it works from encoders as well as keys.

DT_COMPAT_ZMK_SENSOR_ROTATE_DYNAMIC := zmk,behavior-sensor-rotate-dynamic

config ZMK_SENSOR_ROTATE_DYNAMIC
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_SENSOR_ROTATE_DYNAMIC))
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    select SETTINGS
    # zmk_behavior_get_local_id()/zmk_behavior_find_behavior_name_from_local_id()
    # (used to persist/restore bindings by behavior identity) only compile
    # into ZMK's core behind CONFIG_ZMK_BEHAVIOR_LOCAL_IDS, normally
    # pulled in transitively by ZMK_STUDIO -- which is always present
    # wherever this is enabled (see the `depends on` above), so this
    # select is effectively redundant with Studio's own, but kept
    # explicit for clarity and for standalone use of the module.
    select ZMK_BEHAVIOR_LOCAL_IDS
    help
      Encoder (sensor) rotation bindings whose clockwise/counter-clockwise
      assignment can be read and rewritten at runtime over ZMK Studio
      (unlike stock ZMK's compile-time-only sensor-bindings) and persists
      via settings, same as regular keys. See
      src/studio/sensor_binding_subsystem.c for the RPC handlers.

# CODEKEEB PATCH: deep sleep con plazo editable en caliente.
# Se activa en las DOS mitades: cada una vigila su propia inactividad,
# porque si solo durmiera la central el periferico seguiria gastando.
config CODEKEEB_SLEEP
    bool "Deep sleep con tiempo configurable desde ZMK Studio"
    depends on HAS_POWEROFF
    select ZMK_PM
    select PM_DEVICE
    select ZMK_PM_DEVICE_SUSPEND_RESUME
    select POWEROFF
    select SETTINGS
    help
      Duerme el teclado tras N minutos de inactividad, con N guardado en
      flash y editable desde la web. ZMK_SLEEP hace lo mismo pero con el
      plazo fijado al compilar (CONFIG_ZMK_IDLE_SLEEP_TIMEOUT).

DT_COMPAT_ZMK_BEHAVIOR_SLEEP_CFG := zmk,behavior-sleep-cfg

config ZMK_BEHAVIOR_SLEEP_CFG
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_SLEEP_CFG))
    depends on CODEKEEB_SLEEP
